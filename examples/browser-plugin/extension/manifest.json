{
  "manifest_version": 2,
  "name": "Longscrape browser capture",
  "version": "0.1.0",
  "description": "Sends configured browser routes to a local Longscrape receiver.",
  "permissions": [
    "storage",
    "http://127.0.0.1:8000/*",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["rules.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html"
  }
}
