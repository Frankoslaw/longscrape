{
  "manifest_version": 2,
  "name": "Longscrape browser capture example",
  "version": "0.1.0",
  "description": "Sends the current LinkedIn page to a local Longscrape example receiver.",
  "permissions": [
    "storage",
    "http://127.0.0.1:8765/*",
    "https://www.linkedin.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["rules.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html"
  }
}
